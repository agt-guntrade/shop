# --- GitHub -----------------------------------------------------------------
# Fine-grained PAT for agt-guntrade/shop with "Actions: read and write".
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=agt-guntrade
GITHUB_REPO=shop
GITHUB_WORKFLOW_ID=deploy.yaml
GITHUB_REF_NAME=main

# --- Shopify ----------------------------------------------------------------
# Shopify admin -> Settings -> Notifications -> Webhooks -> "Your webhooks
# will be signed with ..." (one secret for all admin-created webhooks).
# If the webhooks are registered by a custom app instead, use that app's
# API secret key (shpss_...) - NOT the Admin API access token (shpat_...).
SHOPIFY_WEBHOOK_SECRET=
# Optional hardening: only accept webhooks from this shop.
SHOPIFY_SHOP_DOMAIN=agt-guntrade.myshopify.com
# Comma separated; empty string means "every topic triggers a deploy".
SHOPIFY_TOPICS=products/create,products/update,products/delete,collections/create,collections/update,collections/delete

# --- Deploy behaviour -------------------------------------------------------
# Collect webhooks for 5 minutes of silence before building.
DEPLOY_DEBOUNCE_MS=300000
# Never delay a build longer than 30 minutes after the first webhook.
DEPLOY_MAX_WAIT_MS=1800000
# Poll interval while waiting for a running build / after a failed dispatch.
DEPLOY_RECHECK_MS=60000
# Do not queue a build while another one is still running.
DEPLOY_SKIP_WHILE_RUNNING=true

# --- Contact form (SMTP) ----------------------------------------------------
# Leave SMTP_HOST empty to disable POST /contact entirely.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender - must be an address the SMTP server allows.
CONTACT_MAIL_FROM=website@agt-guntrade.at
# Comma separated list of recipients.
CONTACT_MAIL_TO=info@agt-guntrade.at
CONTACT_SUBJECT_PREFIX=[Website]
# Origins allowed to POST the form (CORS).
CONTACT_ALLOWED_ORIGINS=https://www.agt-guntrade.at,https://agt-guntrade.at,http://localhost:8000
# Max submissions per IP per window.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# --- Misc -------------------------------------------------------------------
PORT=3000
# Optional: enables POST /deploy with "Authorization: Bearer <token>".
TRIGGER_TOKEN=
